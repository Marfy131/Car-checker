# Copy this file to .env and fill in the values before running docker-compose.prod.yml

# ── Mail server ────────────────────────────────────────────────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# ── Application ────────────────────────────────────────────────────────────────
CARWATCH_EMAIL_ENABLED=true
CARWATCH_EMAIL_FROM=carwatch@example.com

# ── Ports (optional overrides) ─────────────────────────────────────────────────
# APP_PORT=8180

# ── Database (optional overrides) ──────────────────────────────────────────────
# CARWATCH_DB_URL=jdbc:sqlite:/opt/carwatch/data/carwatch.db
# CARWATCH_DB_MAX_POOL=2
# CARWATCH_DB_MIN_IDLE=0

# ── Scheduler (optional overrides) ─────────────────────────────────────────────
# CARWATCH_SCHEDULER_ENABLED=true
